<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/jarvis_dark_blue">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp">
<com.jarvis.assistant.JarvisOrbView android:layout_width="170dp" android:layout_height="170dp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="J.A.R.V.I.S" android:textColor="@color/jarvis_blue" android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="18dp" />
<Button android:id="@+id/btn_grant_overlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/grant_overlay" />
<Button android:id="@+id/btn_grant_mic" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/grant_mic" />
<Button android:id="@+id/btn_toggle_jarvis" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start_jarvis" />
<Button android:id="@+id/btn_api_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/api_mode" />
<Button android:id="@+id/btn_advanced_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مرکز کنترل و تنظیمات پیشرفته جارویس" />
<Button android:id="@+id/btn_screen_analysis" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/screen_analysis" />
<TextView android:id="@+id/tv_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_ready" android:textColor="@color/white" android:gravity="center" android:padding="12dp" />
</LinearLayout></ScrollView>
